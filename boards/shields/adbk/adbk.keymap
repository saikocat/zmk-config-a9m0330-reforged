#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define L_DEFAULT   0
#define L_CAPS      1
#define L_FUNCTION  2

/* The minimal builds pass -DDTS_EXTRA_CPPFLAGS=-DADBK_NO_ENCODER (see build.yaml) */
#ifndef ADBK_NO_ENCODER
&digital_crown {
    status = "okay";
};
#endif

/ {
    behaviors {
        pwrbtn: pwrbtn {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Power / Next BT";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&soft_off>, <&nxt_bt_conn>;
        };

        /*
         * Disruptive actions on the Fn layer need a 1 second hold. A tap does
         * nothing. "tap-preferred" means another key press during the hold
         * does not trigger the action (safe if you forget the Fn layer is on).
         */
        hold_reset: hold_reset {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold: Restart";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&sys_reset>, <&none>;
        };

        hold_boot: hold_boot {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold: Bootloader";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bootloader>, <&none>;
        };

        hold_clr_all: hold_clr_all {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold: Clear All BT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bt_clr_all>, <&none>;
        };
    };

    macros {
        nxt_bt_conn: nxt_bt_conn {
            compatible = "zmk,behavior-macro";
            display-name = "Next BT Profile";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        /* &bt BT_CLR_ALL has two parameters, a hold-tap passes only one */
        bt_clr_all: bt_clr_all {
            compatible = "zmk,behavior-macro";
            display-name = "Clear All BT";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
        };
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&digital_crown>;
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp C_MUTE  &pwrbtn 0 0
    &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS   &kp EQUAL       &kp BSPC        &tog L_FUNCTION &kp KP_EQUAL    &kp KP_SLASH    &kp KP_ASTERISK
    &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp LBKT    &kp RBKT                        &kp KP_N7       &kp KP_N8       &kp KP_N9       &kp KP_PLUS
    &kp LCTRL   &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp APOS    &kp RET                         &kp KP_N4       &kp KP_N5       &kp KP_N6       &kp KP_MINUS
    &kp LSHIFT  &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH                                                &kp KP_N1       &kp KP_N2       &kp KP_N3
    &mo L_CAPS  &kp LALT    &kp LCMD    &kp GRAVE                           &kp SPACE               &kp BSLH    &kp LEFT    &kp RIGHT   &kp DOWN    &kp UP                          &kp KP_N0                       &kp KP_DOT      &kp KP_ENTER
    >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        caps_layer {
            bindings = <
                &trans      &trans
    &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans       &trans         &trans          &trans       &trans     &trans      &trans      &trans
    &trans      &kp RS(Q)   &kp RS(W)   &kp RS(E)   &kp RS(R)   &kp RS(T)   &kp RS(Y)   &kp RS(U)   &kp RS(I)   &kp RS(O)   &kp RS(P)    &trans         &trans                       &trans     &trans      &trans      &trans
    &trans      &kp RS(A)   &kp RS(S)   &kp RS(D)   &kp RS(F)   &kp RS(G)   &kp RS(H)   &kp RS(J)   &kp RS(K)   &kp RS(L)   &trans       &trans         &trans                       &trans     &trans      &trans      &trans
    &trans      &kp RS(Z)   &kp RS(X)   &kp RS(C)   &kp RS(V)   &kp RS(B)   &kp RS(N)   &kp RS(M)   &trans      &trans      &trans                                                   &trans     &trans      &trans
    &trans      &trans      &trans      &trans                              &trans                  &trans      &trans      &trans       &trans         &trans                       &trans                 &trans      &trans
    >;
        };

        function_layer {
            bindings = <
                   &trans      &bt BT_CLR
    &studio_unlock &kp F1      &kp F2      &kp F3      &kp F4          &kp F5       &kp F6      &kp F7       &kp F8      &kp F9      &kp F10     &kp C_VOL_DN &kp C_VOL_UP    &kp DELETE      &trans            &trans          &trans          &trans
    &trans         &trans      &trans      &trans      &hold_reset 0 0 &trans       &trans      &out OUT_USB &trans      &trans      &trans      &bt BT_PRV   &bt BT_NXT                      &trans            &trans          &trans          &trans
    &trans         &trans      &trans      &trans      &hold_boot 0 0  &trans       &trans      &trans       &trans      &trans      &trans      &trans       &trans                          &bt BT_SEL 3      &bt BT_SEL 4    &trans          &trans
    &trans         &trans      &trans      &trans      &trans          &out OUT_BLE &trans      &trans       &trans      &trans      &trans                                                   &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2
    &trans         &trans      &trans      &trans                                   &trans                   &trans      &trans      &trans      &trans       &trans                          &hold_clr_all 0 0                 &trans          &trans
    >;
        };
    };
};
